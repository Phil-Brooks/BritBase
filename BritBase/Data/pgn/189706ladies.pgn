[Black "Fagan, Louisa Matilda"]
[Result "1-0"]
[ECO "C50"]
[Annotator "Hoffer, Leopold"]
[PlyCount "83"]
[EventDate "1897.06.23"]
[EventType "tourn"]
[EventRounds "19"]
[EventCountry "ENG"]
