[Round "7.1"]
[White "Morry, William Ritson"]
[Black "Alexander, C Hugh O'D"]
[Result "0-1"]
[ECO "E60"]
[Annotator "Heidenfeld - BCM"]
[PlyCount "60"]
[EventDate "1956.08.20"]
[EventType "swiss"]
[EventRounds "11"]
