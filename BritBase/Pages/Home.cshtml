@page "/Home"
@model BritBase.Pages.HomeModel
@{
    ViewData["Title"] = "BritBase Home";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <h1 class="display-6 fw-bold mb-3">BritBase.info - British Chess Game Archive</h1>

                    <p class="lead mb-3">
                        BRITBASE.info is an archive of British and Irish chess tournament games, for viewing online and downloading in PGN format.
                    </p>

                    <p>
                        The archive contains historical tournament games, results, crosstables, contemporary reports, photos and related material.
                        It is designed to make the British chess record easier to browse, study and replay.
                    </p>

                    <p>
                        Our collections include major fixtures, player-centred archives and historic tournament runs from the earliest years of British chess up to the present day.
                    </p>

                    <div class="alert alert-light border mb-4">
                        <strong>New:</strong> the BritBase games archive is also available via a searchable interface at
                        <a href="https://www.chesspublishing.com/database/britbase?activeTabId=explorer" target="_blank" rel="noreferrer">chesspublishing.com</a>,
                        which is ideal for more targeted searches and player lookups.
                    </div>

                    <p>
                        BritBase is a collaborative project. Help is always welcome. If you know where to find missing games or corrections,
                        please get in touch. The archive was started in 1997 and has grown through the contributions of many players, researchers and historians.
                    </p>

                    <div class="row g-3 mt-1">
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100 bg-light">
                                <h5 class="fw-bold mb-2">Decades</h5>
                                <p class="mb-0 text-muted">Browse the archive chronologically from pre-1920s through to the 2020s.</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100 bg-light">
                                <h5 class="fw-bold mb-2">Major Fixtures</h5>
                                <p class="mb-0 text-muted">Explore Hastings, Varsity Matches, Gibraltar, Isle of Man and other key events.</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100 bg-light">
                                <h5 class="fw-bold mb-2">Collections</h5>
                                <p class="mb-0 text-muted">Follow themed archives, player collections and notable historical selections.</p>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <p class="mb-0 text-secondary small">
                        BritBase founder and archivist: John Saunders (Twitter @@johnchess)
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
